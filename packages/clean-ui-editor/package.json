{
  "name": "@itguy614/clean-ui-editor",
  "version": "1.2.0",
  "type": "module",
  "description": "A markdown editor for clean-ui — CodeMirror 6 buffer, hidden syntax markers, extensible via a declarative plugin API.",
  "license": "MIT",
  "author": "Kurt Wolf",
  "homepage": "https://itguy614.github.io/clean-ui/editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itguy614/clean-ui.git",
    "directory": "packages/clean-ui-editor"
  },
  "bugs": {
    "url": "https://github.com/itguy614/clean-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "markdown",
    "editor",
    "codemirror",
    "wysiwyg",
    "clean-ui"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/clean-ui-editor.css",
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/icons.js",
    "./src/icons.ts"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly && node ../../scripts/report-bundle-size.mjs && node scripts/check-render-subpath-isolation.mjs",
    "size": "node ../../scripts/report-bundle-size.mjs",
    "check:imports": "node ../clean-ui/scripts/check-dist-imports.mjs .",
    "test": "vitest run --project jsdom --project ssr",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@itguy614/clean-ui": "^1.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@itguy614/clean-ui": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/server-renderer": "^3.5.40",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "vue": "^3.5.40",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2"
  }
}
