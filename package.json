{
  "name": "@itguy614/clean-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @itguy614/clean-ui-docs dev",
    "dev:editor-docs": "pnpm --filter @itguy614/clean-ui-editor-docs dev",
    "build": "pnpm -r build",
    "build:docs": "pnpm --filter @itguy614/clean-ui-docs build",
    "build:editor-docs": "pnpm --filter @itguy614/clean-ui-editor-docs build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r lint",
    "new:component": "node scripts/new-component.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify:fixture": "node scripts/verify-fixture.mjs && node scripts/check-fixture-guarantees.mjs && node scripts/check-bundle-budget.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
